<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://lime.software/project/1.0.4" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://lime.software/project/1.0.4 http://lime.software/xsd/project-1.0.4.xsd">
	<define name="HXCPP_M32" if="32bit || 32"/>
	<define name="32bit" if="HXCPP_M32"/>
	<!-- <haxeflag name="-dce" value="no"/> -->

	<!-- ___________________________ Blossom Settings ___________________________ -->

	<!--Register your characters, stages, etc here-->
	<haxeflag name="--macro" value="blossom.backend.macro.CompileMacro.registerClasses('funkin')"/>

	<!--Compile with Base Game Assets-->
	<!--<define name="BASE_GAME_ASSETS"/>-->

	<!--Disable Camera Buffers unless needed-->
	<!--<define name="CAMERA_NO_BUFFER"/>-->

	<!--Disable Full Screen Scale Mode-->
	<!--<define name="SCALEMODE_NO_FULLSCREEN"/>-->

	<!--Disable Videos-->
	<!--<define name="NO_VIDEOS"/>-->

	<!--Disable Discord RPC-->
	<define name="NO_DISCORD" unless="desktop"/>

	<!-- _________________________ Application Settings _________________________ -->

	<app
		title="Funkin' Blossom" file="Blossom" version="0.1.0"
		packageName="com.raltyro.funkinblossom" package="com.raltyro.funkinblossom" company="raltyro"
	/>

	<window hardware="true" type="opengles" colorDepth="32" background="" fps="0" orientation="landscape"/>
	<window unless="desktop" width="0" height="0" vsync="true" fullscreen="true"/>

	<window if="desktop" width="1280" height="720" fullscreen="false" resizable="true" vsync="false" allowHighDPI="true"/>
	<window if="mobile" resizable="false"/>
	<window if="switch" resizable="true"/>

	<!-- ____________________________ Source Settings ___________________________ -->

	<set name="BUILD_DIR" value="export/debug" if="debug"/>
	<set name="BUILD_DIR" value="export/release" unless="debug"/>
	<set name="BUILD_DIR" value="export/32bit" if="32bit"/>
	<!--<set name="SWF_VERSION" value="11.8"/>-->

	<app main="blossom.backend.BLGame" preloader="flixel.system.FlxBasePreloader"/>
	<classpath name="sourceInternal"/>
	<classpath name="source"/>

	<!-- ____________________________ Assets Settings ___________________________ -->

	<!-- Libraries -->
	<library name="shared" preload="true"/>
	<library name="songs" preload="true"/>
	<library name="skins" preload="true"/>

	<assets path="assets/preload" rename="assets"/>
	<assets path="assets/videos" unless="NO_VIDEOS"/>
	<assets path="assets/shared" library="shared"/>
	<assets path="assets/songs" library="songs"/>
	<assets path="assets/skins" library="skins"/>

	<icon path="art/icons/icon16.png" size="16"/>
	<icon path="art/icons/icon24.png" size="24"/>
	<icon path="art/icons/icon.png" size="32"/>
	<icon path="art/icons/icon.png" size="128"/>
	<icon path="art/icons/icon.png" size="256"/>
	<icon path="art/icons/icon.png" size="512"/>
	<icon path="art/icons/icon.png"/>

	<!-- _______________________________ Libraries ______________________________ -->

	<haxelib name="flixel"/>

	<haxelib name="flixel-addons" version="3.3.2"/>
	<haxelib name="flixel-animate"/>

	<haxelib name="hscript-improved"/>
	<haxedef name="hscriptPos"/>

	<section if="cpp">
		<haxelib name="hxvlc" unless="NO_VIDEOS"/>
		<haxelib name="hxdiscord_rpc" version="1.3.0" unless="NO_DISCORD"/>
	</section>

	<haxelib name="hxcpp-debug-server" if="debug"/>

	<!-- _______________________________ Haxedefines ____________________________ -->

	<!-- This macro allows addition of new functionality and fixes to existing codes. -->
	<haxeflag name="--macro" value="macro.HashLinkFixMacro.init()" if="hl"/>
	<haxeflag name="--macro" value="macro.InternalCompileMacro.init()"/>
	<haxeflag name="--macro" value="blossom.backend.macro.CompileMacro.init()"/>

	<haxedef name="hscriptPos"/>
	<haxedef name="DISCORD_DISABLE_IO_THREAD"/>

	<!-- Disable the Flixel core focus lost screen -->
	<haxedef name="FLX_NO_FOCUS_LOST_SCREEN"/>

	<!-- Disable the Flixel core debugger. Automatically gets set whenever you compile in release mode! -->
	<haxedef name="FLX_NO_DEBUG" unless="debug"/>

	<!-- Uses flixel quads to triangles conversion instead of openfl's -->
	<!-- <haxedef name="FLX_RENDER_TRIANGLE" unless="web"/> -->

	<!-- <haxedef name="HXCPP_GC_BIG_BLOCKS"/> -->
	<haxedef name="HXCPP_CATCH_SEGV"/>
	<haxedef name="HXCPP_ALIGN_ALLOC"/>
	<haxedef name="HXCPP_DEBUG_LINK"/>
	<haxedef name="hxcpp_smart_strings"/>
	<haxedef name="analyzer-optimize" unless="debug"/>
	<section if="debug">
		<haxedef name="HXCPP_DEBUG"/>
		<section if="summary">
			<haxedef name="HXCPP_GC_SUMMARY"/>
			<haxedef name="HXCPP_GC_DEBUG_LEVEL" value="3"/>
		</section>

		<haxedef name="openfl_debug"/>
	</section>

	<!-- Haxe 4.3.0+: Enable pretty syntax errors and stuff. -->
	<!-- <haxedef name="message.reporting" value="pretty"/> -->
	<haxedef name="openfl_dpi_aware"/>
	<!-- <haxedef name="openfl_enable_experimental_update_queue"/> -->
	<haxedef name="openfl_pool_events"/>
	<haxedef name="openfl-enable-handle-error"/>

	<!-- <haxedef name="openfl_no_custom_render_event"/> -->

	<!-- <haxedef name='no-deprecation-warnings'/> -->
	<!-- <haxedef name="gl_stats"/> -->
</project>